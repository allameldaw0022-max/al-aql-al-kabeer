# ---------------------------------------------------------------------------
# العقل الكبير — متغيرات البيئة
# انسخ هذا الملف إلى .env.local محلياً، وأضف نفس المتغيرات في إعدادات Vercel.
# لا تضع أي مفتاح داخل الكود أو ترفعه إلى GitHub.
# ---------------------------------------------------------------------------

# رابط مشروع Supabase — من Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# المفتاح العام (anon / publishable) — آمن للعميل لأن RLS هي الحارس الفعلي
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# رابط الموقع النهائي — يُستخدم في canonical و sitemap و Open Graph
NEXT_PUBLIC_SITE_URL=https://example.com
